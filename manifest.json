{
  "manifest_version": 3,
  "name": "Spotify Vim Navigation",
  "version": "0.1.0",
  "version_name": "0.1.0-rc.1",
  "description": "Keyboard-first navigation for Spotify Web's visible library, tracks, and action menus.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
